# Invest Forest - Environment Configuration Template

# Server Port
PORT=8080

# Environment Mode (development / production)
NODE_ENV=production

# AI / LLM Provider Selection
# Options: auto | heuristic | openai | gemini | anthropic | ollama
# Default is 'auto' (falls back gracefully to offline heuristic if no keys are provided)
LLM_PROVIDER=auto

# Optional: OpenAI API Key (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# Optional: Google Gemini API Key (Gemini 1.5 Flash)
GEMINI_API_KEY=

# Optional: Anthropic Claude API Key (Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# Optional: Local Ollama Endpoint (for 100% private local LLM running on host)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3:latest

# GCP Cloud Deployment (optional for local PoC)
GCP_PROJECT_ID=invest-forest-demo
GCP_REGION=us-central1
